package ouau
Opcodes :: enum {
	MOVE,
	LOADK,
	LOADBOOL,
	LOADNIL,
	GETUPVAL,
	GETGLOBAL,
	GETTABLE,
	SETGLOBAL,
	SETUPVAL,
	SETTABLE,
	NEWTABLE,
	SELF,
	ADD,
	SUB,
	MUL,
	DIV,
	POW,
	UNM,
	NOT,
	CONCAT,
	JMP,
	EQ,

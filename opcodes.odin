	LE,
	TEST,
	CALL,
	TAILCALL,
	RETURN,
	FORLOOP,
	TFORLOOP,
	TFORPREP,
	SETLIST,
	SETLISTO,
	CLOSE,
	CLOSURE,
}
// OP | A | B | C OR:
// OP | A | Bx OR:
// OP | A | sBx
// Each defn set {Move, 2|0|0}
Definition :: struct {
	name:  string,
	width: []int,
}
@(rodata)
